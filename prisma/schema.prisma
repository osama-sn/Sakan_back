generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  OWNER
}

enum PropertyType {
  APARTMENT
  STUDENT_HOUSING
  SHARED_APARTMENT
}

enum GenderPolicy {
  MALE
  FEMALE
  MIXED
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  NEW_BOOKING_REQUEST
  BOOKING_APPROVED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  NEW_MESSAGE
  GENERAL
}

enum ConversationType {
  STUDENT_STUDENT
  STUDENT_OWNER
}

model User {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  fullName          String?
  firstName         String
  lastName          String
  email             String           @unique
  phone             String?          @unique
  passwordHash      String
  role              UserRole         @default(STUDENT)
  profileImage      String?
  bio               String?
  gender            String?
  governorate       String?
  university        String?
  faculty           String?
  major             String?
  academicYear      String?
  housingStatus     String?
  interests         String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  properties        Property[]       @relation("PropertyOwner")
  bookingRequests   BookingRequest[] @relation("StudentBookings")
  reviewedBookings  BookingRequest[] @relation("ReviewedBookings")
  favorites         Favorite[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  propertyViews     PropertyView[]
  conversationIds   String[]         @db.ObjectId
  conversations     Conversation[]   @relation(fields: [conversationIds], references: [id])
  sentMessages      Message[]        @relation("UserSentMessages")

  @@index([role])
}

model RefreshToken {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  token       String   @unique
  userId      String   @db.ObjectId
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id                      String            @id @default(auto()) @map("_id") @db.ObjectId
  ownerId                 String            @db.ObjectId
  title                   String
  description             String
  propertyType            PropertyType
  city                    String
  area                    String
  address                 String
  latitude                Float?
  longitude               Float?
  genderPolicy            GenderPolicy
  isVerified              Boolean           @default(true)
  rating                  Float             @default(4.8)
  reviewsCount            Int               @default(12)
  viewsCount              Int               @default(0)
  distanceFromUniversity  String?
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  owner           User              @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  images          PropertyImage[]
  rooms           Room[]
  amenities       PropertyAmenity[]
  favorites       Favorite[]
  bookingRequests BookingRequest[]
  views           PropertyView[]
  conversations   Conversation[]

  @@index([ownerId])
  @@index([city])
  @@index([area])
  @@index([isActive])
}

model PropertyImage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId  String   @db.ObjectId
  url         String
  publicId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Room {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  propertyId    String           @db.ObjectId
  name          String
  description   String?
  capacity      Int
  occupiedBeds  Int              @default(0)
  monthlyPrice  Float
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  property      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  images        RoomImage[]
  amenities     RoomAmenity[]
  bookings      BookingRequest[]

  @@index([propertyId])
}

model RoomImage {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String   @db.ObjectId
  url         String
  publicId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Amenity {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  name        String            @unique
  icon        String?
  category    String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  properties  PropertyAmenity[]
  rooms       RoomAmenity[]
}

model PropertyAmenity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId  String   @db.ObjectId
  amenityId   String   @db.ObjectId

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}

model RoomAmenity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId      String   @db.ObjectId
  amenityId   String   @db.ObjectId

  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomId, amenityId])
}

model BookingRequest {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  studentId       String        @db.ObjectId
  propertyId      String        @db.ObjectId
  roomId          String        @db.ObjectId
  status          BookingStatus @default(PENDING)
  message         String?
  rejectionReason String?
  reviewedById    String?       @db.ObjectId
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student         User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  reviewer        User?         @relation("ReviewedBookings", fields: [reviewedById], references: [id])
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room            Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([propertyId])
  @@index([roomId])
  @@index([status])
}

model Favorite {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  propertyId  String   @db.ObjectId
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  userId      String           @db.ObjectId
  title       String
  body        String
  type        NotificationType
  isRead      Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model PropertyView {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId  String   @db.ObjectId
  userId      String?  @db.ObjectId
  viewerIp    String?
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
  @@index([propertyId, userId])
  @@index([propertyId, viewerIp])
}

model Conversation {
  id                  String           @id @default(auto()) @map("_id") @db.ObjectId
  participantIds      String[]         @db.ObjectId
  type                ConversationType
  propertyId          String?          @db.ObjectId

  lastMessageText     String?
  lastMessageAt       DateTime?
  lastMessageSenderId String?          @db.ObjectId

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  participants        User[]           @relation(fields: [participantIds], references: [id])
  property            Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  messages            Message[]

  @@index([participantIds])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String       @db.ObjectId
  senderId       String       @db.ObjectId
  text           String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([conversationId, createdAt])
}


