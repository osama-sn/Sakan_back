    {
      "name": "02. Users Profile",
      "item": [
        {
          "name": "Get My Matching Roommates (Auto match by my University/Faculty/Governorate)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/roommates?matchMyProfile=true&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["users", "roommates"],
              "query": [
                { "key": "matchMyProfile", "value": "true" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Roommates Directory (Search & Filters)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/roommates?page=1&limit=10&governorate=&university=&housingStatus=",
              "host": ["{{baseUrl}}"],
              "path": ["users", "roommates"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "governorate", "value": "الإسكندرية", "disabled": true },
                { "key": "university", "value": "جامعة القاهرة", "disabled": true },
                { "key": "faculty", "value": "كلية الهندسة", "disabled": true },
                { "key": "housingStatus", "value": "يبحث عن شريك سكن", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"أحمد\",\n  \"lastName\": \"محمود المعدل\",\n  \"bio\": \"طالب في كلية الهندسة جامعة القاهرة\",\n  \"gender\": \"ذكر\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"Password123\",\n  \"newPassword\": \"NewPassword123\"\n}"
