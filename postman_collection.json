              "raw": "{\n  \"fullName\": \"أحمد محمد إبراهيم\",\n  \"email\": \"student2@eng.asu.edu.eg\",\n  \"phone\": \"01012345679\",\n  \"password\": \"Password123\",\n  \"confirmPassword\": \"Password123\",\n  \"role\": \"STUDENT\",\n  \"gender\": \"MALE\",\n  \"governorate\": \"القاهرة\",\n  \"university\": \"جامعة عين شمس\",\n  \"faculty\": \"كلية الهندسة\",\n  \"major\": \"هندسة مدنية\",\n  \"academicYear\": \"الفرقة الأولى\"\n}"
