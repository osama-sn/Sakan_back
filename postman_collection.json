    {
      "name": "03. Properties",
      "item": [
        {
          "name": "List Properties (Public - Search & Filters)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}", "disabled": false },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties?page=1&limit=10&governorate=الجيزة&university=جامعة القاهرة",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "governorate", "value": "الجيزة" },
                { "key": "university", "value": "جامعة القاهرة" },
                { "key": "faculty", "value": "هندسة", "disabled": true },
                { "key": "search", "value": "سكن", "disabled": true },
                { "key": "city", "value": "الجيزة", "disabled": true },
                { "key": "area", "value": "الدقي", "disabled": true },
                { "key": "propertyType", "value": "STUDENT_HOUSING", "disabled": true },
                { "key": "genderPolicy", "value": "MALE", "disabled": true },
                { "key": "minPrice", "value": "1000", "disabled": true },
                { "key": "maxPrice", "value": "5000", "disabled": true },
                { "key": "amenities", "value": "WiFi,Air Conditioning", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Property (Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('propertyId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"سكن النور للطلاب بجوار الجامعة\",\n  \"description\": \"سكن طلابي مجهز بالكامل ومكيف قريب من محطة المترو والجامعة مع توفر خدمة إنترنت عالية السرعة.\",\n  \"propertyType\": \"STUDENT_HOUSING\",\n  \"city\": \"القاهرة\",\n  \"area\": \"مدينة نصر\",\n  \"address\": \"شارع عباس العقاد بجوار الجامعة\",\n  \"latitude\": 30.0561,\n  \"longitude\": 31.3301,\n  \"genderPolicy\": \"MALE\",\n  \"amenityIds\": []\n}"
            },
            "url": { "raw": "{{baseUrl}}/properties", "host": ["{{baseUrl}}"], "path": ["properties"] }
          }
        },
        {
          "name": "Get Property Details (Public)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] }
          }
        },
        {
          "name": "Record Property View",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}", "disabled": true },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}/view", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}", "view"] }
          }
        },
        {
          "name": "Update Property (Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"سكن النور المتميز للطلاب\",\n  \"description\": \"تحديث للوصف: سكن راقي هادئ مع خدمات نظافة أسبوعية ومصعد\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] }
          }
        },
        {
          "name": "Deactivate / Soft Delete Property (Owner)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] }
          }
        },
        {
          "name": "Delete Property Permanently (Owner)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/{{propertyId}}?permanent=true",
              "host": ["{{baseUrl}}"],
              "path": ["properties", "{{propertyId}}"],
              "query": [
                { "key": "permanent", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Upload Property Images (Owner - multipart/form-data)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "images", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}/images", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}", "images"] }
          }
        },
        {
          "name": "Delete Property Image (Owner)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}/images/{{imageId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}", "images", "{{imageId}}"] }
          }
        },
        {
          "name": "Reorder Property Images (Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"images\": [\n    { \"id\": \"{{imageId}}\", \"sortOrder\": 1 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}/images/order", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}", "images", "order"] }
          }
        }
      ]
