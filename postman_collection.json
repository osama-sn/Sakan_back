    {
      "name": "05. Booking Requests",
      "item": [
        {
          "name": "Create Booking Request (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    pm.collectionVariables.set('bookingId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"message\": \"مرحباً، أود حجز سرير في هذه الغرفة للفصل الدراسي القادم.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/booking-requests", "host": ["{{baseUrl}}"], "path": ["booking-requests"] }
          }
        },
        {
          "name": "Get My Booking Requests (Student)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking-requests/my?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["booking-requests", "my"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "PENDING", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Approve Booking Request (Owner - Atomic Transaction)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": { "raw": "{{baseUrl}}/booking-requests/{{bookingId}}/approve", "host": ["{{baseUrl}}"], "path": ["booking-requests", "{{bookingId}}", "approve"] }
          }
        },
        {
          "name": "Reject Booking Request (Owner)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"عذراً، الغرفة غير متوفرة حالياً.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/booking-requests/{{bookingId}}/reject", "host": ["{{baseUrl}}"], "path": ["booking-requests", "{{bookingId}}", "reject"] }
          }
        },
        {
          "name": "Cancel Booking Request (Student)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Accept-Language", "value": "ar" }
            ],
            "url": { "raw": "{{baseUrl}}/booking-requests/{{bookingId}}/cancel", "host": ["{{baseUrl}}"], "path": ["booking-requests", "{{bookingId}}", "cancel"] }
          }
        }
      ]
    },
